{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gate Result v1",
  "description": "Portable result contract shared by HermesGate, PyGate, and QuickGate.js.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "status",
    "snapshot_digest",
    "checked_paths",
    "checks",
    "findings",
    "command_versions",
    "elapsed_ms",
    "output_truncated",
    "errors"
  ],
  "properties": {
    "schema": {
      "const": "gate-result/v1"
    },
    "version": {
      "type": "string",
      "const": "gate-result/v1",
      "deprecated": true,
      "description": "Compatibility discriminator retained for one release. New consumers must use schema."
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "timeout",
        "error"
      ]
    },
    "snapshot_digest": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_digest_after": {
      "type": [
        "string",
        "null"
      ]
    },
    "snapshot_changed": {
      "type": "boolean"
    },
    "checked_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "findings": {
      "type": "array"
    },
    "command_versions": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object"
          }
        ]
      }
    },
    "elapsed_ms": {
      "type": "integer",
      "minimum": 0
    },
    "output_truncated": {
      "type": "boolean"
    },
    "errors": {
      "type": "array",
      "items": {
        "oneOf": [
          {"type": "string"},
          {"type": "object"}
        ]
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "oneOf": [
          {"type": "string"},
          {"type": "object"}
        ]
      }
    },
    "config_identity": {
      "type": [
        "string",
        "object"
      ]
    },
    "config_digest": {
      "type": "string"
    },
    "config_version": {
      "type": "string"
    },
    "package_version": {
      "type": "string"
    },
    "state_dir": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "name",
        "status",
        "argv",
        "elapsed_ms",
        "timed_out",
        "output_truncated"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "timeout",
            "missing",
            "error",
            "skipped"
          ]
        },
        "argv": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "elapsed_ms": {
          "type": "integer",
          "minimum": 0
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "signal": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "timed_out": {
          "type": "boolean"
        },
        "output_truncated": {
          "type": "boolean"
        }
      }
    }
  }
}
