{
  "name": "quick-gate",
  "version": "0.2.3",
  "description": "JavaScript and TypeScript quality gate CLI with bounded auto-repair and escalation artifacts",
  "type": "module",
  "exports": {
    ".": "./src/api.js",
    "./cli": "./src/cli.js"
  },
  "bin": {
    "quick-gate": "src/cli.js"
  },
  "files": [
    "src/",
    "schemas/"
  ],
  "scripts": {
    "lint": "for file in src/*.js test/*.test.js; do node --check \"$file\" || exit 1; done",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "Apache-2.0",
  "author": "Hermes Labs <rbosch@lpci.ai> (https://hermes-labs.ai)",
  "homepage": "https://github.com/hermes-labs-ai/quick-gate-js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hermes-labs-ai/quick-gate-js.git"
  },
  "bugs": {
    "url": "https://github.com/hermes-labs-ai/quick-gate-js/issues"
  },
  "keywords": [
    "quality-gate",
    "js-ci",
    "fail-fast",
    "ci",
    "lint",
    "typecheck",
    "lighthouse",
    "auto-repair",
    "deterministic",
    "eslint",
    "typescript",
    "nextjs",
    "react",
    "vue",
    "svelte"
  ],
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
